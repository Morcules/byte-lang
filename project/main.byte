// Just an example that does literally nothing just for testing //

#import "../std-lib/general_syscall_functions.byte";

void : test(i64 test_var : [stack], i64 test_var_two : [stack]) {
    test_var = 15;

    i64 test_variable_init = test_var;
}

void : main() {
    i64 var = 5;
    i16 var2 = 2;
    i8 var3 = 1;
    u8 char = 'a';
    i64 exit_code = 30;
    i64 exit_code_clone = exit_code;
    u64 test = 5;
    u64 test2 = 10;
    u8 something = 30;
    u8 something_clone = something;
    i64 exit_code_success = 0;

    array[u8, 12] string = "hello world\0";

    something = string[2];

    reg[x1] = 10;

    cmp(test2, test) {
        .ne {
            i64 test_integer = var;

            test_integer = 10;

            bl(term, 0);
        }
        .eq {
            array[u8, 4] arr = [1, 2, 3, char];

            arr[var3] = 0;

            bl(term, 1);
        }
    }

    exit_code_success = 1;

    bl(test, var, exit_code_clone);
    
    bl(term, exit_code_success);
}
